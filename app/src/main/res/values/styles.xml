<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KotlinMaster" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.KotlinMaster.Splash" parent="Theme.SplashScreen">
